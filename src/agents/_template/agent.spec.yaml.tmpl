# Agent spec: generated by scripts/new_agent.py on [[ created ]].
# Field reference: README.md#agentspec-field-reference
# [[ ... ]] = scaffold-time placeholders (already filled); {{ ... }} in prompt.md = runtime vars.
name: [[ name ]]
public_name: [[ public_name ]]
description: >-
  [[ description ]]
version: 0.1.0
owner: [[ owner ]]
kind: [[ kind ]]

instructions_file: prompt.md
prompt_vars: {}
includes: [istr_rules]

model:
  profile: [[ profile ]]          # default | reasoning | fast  (env [[ env_prefix ]]_MODEL overrides)
  temperature: [[ temperature ]]

tools:[[ tools_yaml ]]

middleware: [audit, tipping_off, token_budget]
max_tool_calls: 15

guardrails:
  input: [prompt_injection]
  output: [tipping_off, filing_action]
  pii_redaction: true

memory:
  enabled: false
  backend: jsonl
  max_turns: 3

output_schema: null
reasoning_trace: true

a2a:
  port: [[ port ]]                 # env PORT_[[ env_prefix ]] overrides
  skills:
    - id: [[ name ]]
      name: [[ skill_name ]]
      description: >-
        [[ description ]]

observability:
  span_name: istr.[[ name ]]
  tags: [istr, [[ kind ]]]
