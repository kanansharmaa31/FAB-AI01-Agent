# =============================================================================
# ISTR Agent Mesh: environment template. Copy to .env (git-ignored).
# Never commit real keys. Synthetic data only.
# =============================================================================

# --- LLM provider ---------------------------------------------------------------
# openai_compat | azure_openai | foundry | anthropic | ollama | stub
#   stub = deterministic offline client: runs the whole mesh with no key.
LLM_PROVIDER=stub
# openai_compat: any OpenAI-compatible endpoint (vLLM, LM Studio, Ollama /v1, gateway ...)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
# Model profiles referenced by AgentSpec.model.profile (default | reasoning | fast)
LLM_MODEL_DEFAULT=
LLM_MODEL_REASONING=
LLM_MODEL_FAST=

# azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_USE_ENTRA_ID=false
# foundry (pip install --pre agent-framework-foundry azure-identity)
FOUNDRY_PROJECT_ENDPOINT=
# anthropic (pip install --pre agent-framework-anthropic)
ANTHROPIC_API_KEY=
# ollama native client (pip install --pre agent-framework-ollama)
OLLAMA_HOST=http://localhost:11434

# --- Per-agent overrides (optional; <NODE> = upper-cased folder name under src/agents/)
# EXAMPLE_COORDINATOR_PROVIDER=azure_openai
# EXAMPLE_COORDINATOR_MODEL=gpt-4.1
# EXAMPLE_COORDINATOR_API_KEY=
# EXAMPLE_SPECIALIST_MODEL=

# --- Workflow wiring: which agents the pipeline calls ---------------------------
# Agent that runs the investigation (must exist under src/agents/)
WORKFLOW_COORDINATOR_NODE=example_coordinator
# Agent giving the semantic COMPLIANCE_PASSED/FAILED verdict. Empty = step skipped
# (deterministic guardrails + RBAC still run). If set, it fails closed when unreachable.
WORKFLOW_COMPLIANCE_NODE=

# --- A2A node ports (optional; defaults come from each agent.spec.yaml) ----------
A2A_HOST=127.0.0.1
A2A_TIMEOUT=120
# PORT_EXAMPLE_COORDINATOR=8020
# PORT_EXAMPLE_SPECIALIST=8021

# --- MCP services (mock by default; point at real GERNAS services to go live) --
TRANSACTIONS_MCP_URL=http://127.0.0.1:9101/mcp
KYC_MCP_URL=http://127.0.0.1:9102/mcp
SCREENING_MCP_URL=http://127.0.0.1:9103/mcp
GRAPH_MCP_URL=http://127.0.0.1:9104/mcp
POLICY_RAG_MCP_URL=http://127.0.0.1:9105/mcp
MCP_REQUEST_TIMEOUT=30
# Sent as X-API-Key to every MCP service when set
MCP_API_KEY=

# --- Memory -----------------------------------------------------------------------
ENABLE_CONVERSATION_MEMORY=true
CONVERSATION_BACKEND=jsonl
CONVERSATION_MAX_TURNS=3
CONVERSATION_STORE_DIR=data/conversations
CONVERSATION_REDIS_URL=redis://127.0.0.1:6379/0

# --- Feature flags ------------------------------------------------------------------
ENABLE_COMPLIANCE=true
# Draft quality checks in human_review_gate. Status is ALWAYS PENDING_MLRO_REVIEW regardless.
ENABLE_HUMAN_REVIEW_GATE=true
# Keep false: redacts PII from audit logs and traces (ISTR rule 4)
ENABLE_SENSITIVE_DATA=false
MAX_TOOL_CALLS_PER_RUN=15

# --- Audit + logging ------------------------------------------------------------------
AUDIT_LOG_FILE=data/logs/audit_trail.jsonl
LOG_FILE=data/logs/istr_mesh.log
LOG_LEVEL=INFO
LOG_JSON=false

# --- Observability (MAF-native OpenTelemetry) -------------------------------------------
# dev | prod | off
OBS_PROFILE=off
ENABLE_INSTRUMENTATION=true
ENABLE_CONSOLE_EXPORTERS=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=istr_mesh
APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Opik (optional LLM tracing; pip install opentelemetry-exporter-otlp-proto-http [opik])
OPIK_ENABLED=false
# Self-hosted base URL, e.g. http://localhost:5173/api (empty = Opik Cloud)
OPIK_URL_OVERRIDE=
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=istr-agent-mesh

# --- API / DevUI ----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
DEVUI_HOST=127.0.0.1
DEVUI_PORT=8090
DEVUI_USER=analyst1
